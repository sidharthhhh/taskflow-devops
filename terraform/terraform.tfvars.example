# =============================================================================
# TaskFlow Terraform Configuration Variables (Example)
# Copy this file to `terraform.tfvars` and customize before applying.
# =============================================================================

# AWS Region to deploy resources into (Sydney)
aws_region   = "ap-southeast-2"
project_name = "taskflow"
environment  = "prod"
owner        = "Sidharth"

# GitHub repository in 'owner/repo' format
github_repo = "sidharthhhh/taskflow-devops"

# Network Configuration (Custom VPC across 2 Sydney AZs)
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["ap-southeast-2a", "ap-southeast-2b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]

# EKS Cluster Configuration (Free-Tier eligible t3.micro nodes)
cluster_version     = "1.31"
node_instance_types = ["t3.micro"]
node_desired_size   = 4
node_min_size       = 2
node_max_size       = 6

# Restrict public EKS API access if desired (default open to 0.0.0.0/0)
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# Container Registry Configuration (All Polyglot Microservices + Frontend)
ecr_repositories = [
  "taskflow-app",
  "taskflow-auth-service",
  "taskflow-analytics-service",
  "taskflow-scheduler-service",
  "taskflow-notification-service",
  "taskflow-audit-service",
  "taskflow-frontend"
]
ecr_image_tag_mutability = "MUTABLE"

# Cost Guardrail Budget Configuration
enable_budget        = true
monthly_budget_limit = "25.0"
budget_alert_email   = "your-email@example.com"
