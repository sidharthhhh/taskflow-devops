# -----------------------------------------------------------------------------
# AWS Budget & Cost Guardrails
# Automatically alerts when forecasted or actual spend exceeds threshold
# -----------------------------------------------------------------------------

resource "aws_budgets_budget" "cost_guardrail" {
  count             = var.enable_budget ? 1 : 0
  name              = "${var.project_name}-${var.environment}-monthly-budget"
  budget_type       = "COST"
  limit_amount      = var.monthly_budget_limit
  limit_unit        = "USD"
  time_unit         = "MONTHLY"
  time_period_start = "2026-01-01_00:00"

  # Alert 1: 80% Actual spend reached
  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = [var.budget_alert_email]
  }

  # Alert 2: 100% Forecasted spend reached
  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    notification_type          = "FORECASTED"
    subscriber_email_addresses = [var.budget_alert_email]
  }
}
