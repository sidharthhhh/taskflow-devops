# ==========================================
# TaskFlow Environment Configuration Template
# Copy this file to .env and adjust values
# ==========================================

SERVER_PORT=8080
SPRING_APPLICATION_NAME=TaskFlow

# ------------------------------------------
# Option A: Local H2 In-Memory Database (Default)
# ------------------------------------------
SPRING_DATASOURCE_URL=jdbc:h2:mem:taskflowdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_H2_CONSOLE_ENABLED=true

# ------------------------------------------
# Option B: PostgreSQL (Local / Docker / K8s / RDS)
# Uncomment below lines to switch to PostgreSQL
# ------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskflowdb
# SPRING_DATASOURCE_USERNAME=taskflow
# SPRING_DATASOURCE_PASSWORD=taskflowpassword
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_H2_CONSOLE_ENABLED=false
