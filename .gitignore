# =============================================================================
# TaskFlow DevOps - Git Ignore Policy (Polyglot Microservices Edition)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Java & Maven Build Outputs (services/task-service)
# -----------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Keep Maven Wrapper binaries
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# -----------------------------------------------------------------------------
# 2. Node.js & Next.js (frontend & services/{auth,analytics,scheduler}-service)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# 3. Golang Build & Test Outputs (services/notification-service)
# -----------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
services/notification-service/notification-service

# -----------------------------------------------------------------------------
# 4. Rust & Audit Volume Data (services/audit-service)
# -----------------------------------------------------------------------------
**/*.rs.bk
**/data/*.jsonl
audit.jsonl

# -----------------------------------------------------------------------------
# 5. Environment Variables & Secret Credentials
# -----------------------------------------------------------------------------
.env
**/.env
*.env
!.env.example
!**/.env.example

# Local credentials & certificates
*.pem
*.key
*.pfx
*.p12
*.crt
id_rsa*
credentials
secrets.local.*

# -----------------------------------------------------------------------------
# 6. Terraform State, Artifacts & Cache
# -----------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Terraform Variables & Secrets (Keep templates)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example

# S3 Backend configuration file (Keep template)
backend.hcl
!backend.hcl.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI Configuration
.terraformrc
terraform.rc

# -----------------------------------------------------------------------------
# 7. Kubernetes, Docker & Security Scan Artifacts
# -----------------------------------------------------------------------------
.kube/
kubeconfig
*.kubeconfig
*.k3d.yaml
*.sarif

# -----------------------------------------------------------------------------
# 8. Python Caches & Virtual Environments (Scripts & Load Testing)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/

# -----------------------------------------------------------------------------
# 9. IDEs & Editor Settings
# -----------------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.code-workspace
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
/nbproject/private/
/nbbuild/
/nbattrs.xml
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 10. Operating System Artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Project Plan (Local Tracking)
plan

# -----------------------------------------------------------------------------
# 11. Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
